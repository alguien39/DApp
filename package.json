{
  "name": "boletotec",
  "version": "1.0.0",
  "description": "BoletoTEC: boletera descentralizada con NFTs (proyecto de ejemplo, Parcial 3)",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
